# OpenClaw Configuration
# Generated for Railway deployment

# OpenRouter API Key - Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# Telegram Bot Token - Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# OpenClaw Gateway Token - Auto-generated secret token
OPENCLAW_GATEWAY_TOKEN=a7f2c9e4b1d6f3a8c5e9b2d7f4a1c8e5b9d2f6a3c7e1b4d8f2a5c9e3b6d9f1a4

# Optional: Database URL if needed
# DATABASE_URL=postgresql://...

# Optional: Log level
LOG_LEVEL=info

# Server port
PORT=3000
